{
  "openapi": "3.0.3",
  "info": {
    "title": "Sample Profile API",
    "version": "1.0.0",
    "description": "Example only; points to no live service."
  },
  "paths": {
    "/users/{userId}": {
      "get": {
        "summary": "Read a user profile",
        "operationId": "getUserProfile",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      },
      "patch": {
        "summary": "Update a user profile",
        "operationId": "updateUserProfile",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "displayName": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/admin/reports": {
      "get": {
        "summary": "Read admin reports",
        "operationId": "getAdminReports",
        "responses": {
          "200": {
            "description": "Reports"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  }
}